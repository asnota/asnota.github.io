---
import "../../styles/global.css";
import type { MarkdownInstance } from "astro";
import type {
  FrontmatterIntro,
  FrontmatterPost,
} from "../../posts/frontmatter-post";
import BlogPost from "../../components/blog/BlogPost.astro";
import HomeLayout from "../../layouts/HomeLayout.astro";
export async function getStaticPaths() {
  const introFiles = Object.values(
    import.meta.glob<MarkdownInstance<FrontmatterIntro>>(
      "../../posts/*-intro*.{md,mdx}",
      { eager: true },
    ),
  ) as MarkdownInstance<FrontmatterIntro>[];

  const posts = Object.values(
    import.meta.glob<MarkdownInstance<FrontmatterPost>>(
      ["../../posts/*.{md,mdx}", "!../../posts/*-intro*.{md,mdx}"],
      { eager: true },
    ),
  ) as MarkdownInstance<FrontmatterIntro>[];

  const paths = [];

  // Files sort by number, oldest first.
  const link = (file?: MarkdownInstance<FrontmatterIntro>) =>
    file && { title: file.frontmatter.title, path: file.frontmatter.path };

  for (const [index, intro] of introFiles.entries()) {
    paths.push({
      params: {
        blogPath: encodeURIComponent(intro.frontmatter.path),
      },
      props: {
        intro,
        post: posts.find((post) => post.file.includes(intro.frontmatter.post)),
        older: link(introFiles[index - 1]),
        newer: link(introFiles[index + 1]),
      },
    });
  }

  return paths;
}

const { intro, post, older, newer } = Astro.props;
---

<HomeLayout
  metadata={{
    title: `${intro.frontmatter.title} | Anna Shvets`,
    description: intro.frontmatter.description,
  }}
>
  <BlogPost post={post} intro={intro} older={older} newer={newer} />
</HomeLayout>
