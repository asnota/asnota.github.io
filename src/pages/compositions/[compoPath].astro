---
import "../../styles/global.css";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import WorkLink from "../../components/compositions/WorkLink.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const compositionsCollection = await getCollection("compositions");
  const paths = [];

  for (const entry of compositionsCollection) {
    const data = entry.data;
    const siblings = data.secondary
      .flatMap((secondary) => secondary.compositions)
      .filter((composition) => composition.compositionDescription && composition.path);

    for (const secondary of data.secondary) {
      for (const composition of secondary.compositions) {
        if (composition.compositionDescription && composition.path) {
          paths.push({
            params: {
              compoPath: encodeURIComponent(composition.path),
            },
            props: {
              composition,
              genre: data.principalTitle,
              secondaryTitle: secondary.secondaryTitle,
              others: siblings.filter((sibling) => sibling.path !== composition.path),
            },
          });
        }
      }
    }
  }

  return paths;
}

const { composition, genre, secondaryTitle, others } = Astro.props;
const metadata = {
  title: `${composition.compositionTitle} | Anna Shvets`,
  description: composition.seoDescription,
};

const details = [
  { label: "Genre", text: secondaryTitle ? `${genre}, ${secondaryTitle}` : genre },
  composition.duration && { label: "Duration", text: composition.duration },
].filter(Boolean) as { label: string; text: string }[];
---

<BaseLayout metadata={metadata}>
  <article>
    <header class="border-b border-rule">
      <div class="mx-auto max-w-[1240px] px-6 pt-10 pb-16 md:px-12 md:pt-14 md:pb-20">
        <a href="/compositions" class="text-link inline-flex items-center gap-1.5 text-sm text-violet-ink">
          <Icon name="tabler:arrow-left" class="h-4 w-4" aria-hidden="true" />
          All compositions
        </a>
        <h1 class="mt-10 max-w-[18ch] font-display text-[clamp(3rem,6vw,4.5rem)] leading-none font-normal tracking-[-0.02em] text-balance md:mt-14">
          {composition.compositionTitle}
        </h1>
        {
          composition.compositionSubTitle && (
            <p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-ink-soft">
              {composition.compositionSubTitle}
            </p>
          )
        }
      </div>
    </header>

    <div
      class="mx-auto grid max-w-[1240px] gap-10 px-6 py-16 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-16 md:px-12 md:py-24"
    >
      <dl class="flex flex-col gap-6 md:sticky md:top-28 md:self-start">
        {
          details.map((item) => (
            <div>
              <dt class="text-xs font-semibold tracking-[0.14em] text-violet-ink uppercase">{item.label}</dt>
              <dd class="mt-2 leading-relaxed">{item.text}</dd>
            </div>
          ))
        }
      </dl>
      <div class="max-w-[65ch] space-y-6 text-lg leading-relaxed">
        {composition.compositionDescription?.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="border-t border-rule" aria-labelledby="more-heading">
        <div class="mx-auto grid max-w-[1240px] gap-8 px-6 py-16 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-16 md:px-12 md:py-24">
          <h2 id="more-heading" class="font-display text-4xl leading-[1.1] font-normal text-balance">
            More {genre.toLowerCase()}
          </h2>
          <ul class="border-t border-ink">
            {others.map((work) => (
              <WorkLink path={work.path!} title={work.compositionTitle} subtitle={work.compositionSubTitle} />
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
