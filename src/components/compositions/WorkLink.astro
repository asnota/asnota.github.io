---
import { Icon } from "astro-icon/components";

interface Props {
  path: string;
  title: string;
  subtitle?: string;
  label?: string;
}

const { path, title, subtitle, label } = Astro.props;
---

<li class="border-b border-rule">
  <a href={`/compositions/${path}`} class="group flex items-start justify-between gap-6 py-5">
    <span>
      <span class="block font-display text-2xl leading-snug transition-colors group-hover:text-violet-ink">
        {title}
      </span>
      {subtitle && <span class="mt-1 block text-sm leading-relaxed text-ink-soft">{subtitle}</span>}
    </span>
    <span class="mt-1.5 inline-flex shrink-0 items-center gap-1.5 text-sm text-violet-ink">
      {label && <span class="hidden sm:inline">{label}</span>}
      <Icon
        name="tabler:arrow-right"
        class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
        aria-hidden="true"
      />
    </span>
  </a>
</li>
