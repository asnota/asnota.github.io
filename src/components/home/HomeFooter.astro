---
import { EMAIL, STREAM_PROFILES } from "../../consts";
---

<footer id="contact" class="scroll-mt-20 bg-night font-text text-night-ink">
  <div class="mx-auto max-w-[1240px] px-6 py-20 md:px-12 md:py-28">
    <div class="grid gap-12 md:grid-cols-2 md:items-end">
      <div>
        <h2 class="font-display text-4xl font-normal leading-[1.1] text-balance lg:text-[3.25rem]">
          Commissions, performances &amp; collaborations
        </h2>
        <a
          href={`mailto:${EMAIL}`}
          class="mt-8 block rounded-full bg-night-link px-5 py-3 text-center font-medium text-night transition-colors hover:bg-night-ink md:inline-block md:px-8"
          >Email Anna</a
        >
      </div>
      <ul class="grid grid-cols-2 gap-x-8 gap-y-4 md:grid-cols-3">
        {
          Object.values(STREAM_PROFILES).map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                class="text-night-ink underline decoration-1 underline-offset-[0.3em] hover:decoration-2"
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
